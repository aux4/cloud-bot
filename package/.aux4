{
  "scope": "aux4",
  "name": "cloud-bot",
  "version": "0.1.16",
  "description": "Run an aux4 WhatsApp bot on one aux4.cloud command machine",
  "license": "Apache-2.0",
  "tags": [
    "bot",
    "whatsapp",
    "cloud",
    "turso"
  ],
  "dependencies": [
    "aux4/bot@>=0.2.15",
    "aux4/bot-meta@>=0.1.27",
    "aux4/secret-aux4-cloud",
    "aux4/cloud@>=1.2.34",
    "aux4/config@>=0.2.11",
    "aux4/bot-chat@>=0.1.0"
  ],
  "type": "cloud",
  "cloud": {
    "deployment": "new-vm",
    "machine": {
      "name": "whatsapp-bot",
      "size": "xs",
      "disk": 1,
      "type": "command",
      "tenantCapabilities": {
        "packages": false,
        "webhooks": true
      }
    },
    "capabilities": [
      "turso:database"
    ],
    "commands": [
      "whatsapp",
      "cloud-bot"
    ],
    "replaces": [
      "aux4/bot-cloud"
    ]
  },
  "system": [
    [
      "test:node --version",
      "brew:node",
      "linux:nodejs"
    ]
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "whatsapp",
          "execute": [
            "set:botConfig=!node ${packageDir}/lib/config.mjs values(botId, phoneNumberId, verifyToken, token, appSecret, apiUrl, agentMachine, brainCommand)",
            "set:botConfig=json:${botConfig}",
            "set:channels=${botConfig.channels}",
            "set:bots=${botConfig.bots}",
            "set:defaults=${botConfig.defaults}",
            "json:stdin:aux4 bot ingest params(channels, bots, defaults, db, dedupeTtl, queue)",
            "set:ingestStatus=${response.statusCode}",
            "set:expected=${response.enqueued}",
            "node ${packageDir}/lib/status.mjs value(ingestStatus)",
            "nout:aux4 bot retry-work --expected value(expected) --attempts value(retryAttempts) --delay value(retryDelay) --maxDelay value(retryMaxDelay) --budget value(retryBudget) --maxMessages value(retryMaxMessages) params(channels, bots, defaults, db, tmpDir, queue)",
            "log:{\"ok\":true}"
          ],
          "help": {
            "text": "Verify and enqueue signed WhatsApp events, then process queued work with bounded retries",
            "variables": [
              {
                "name": "botId",
                "text": "Configured bot identifier",
                "default": "whatsapp-bot"
              },
              {
                "name": "phoneNumberId",
                "text": "Meta WhatsApp phone number ID",
                "default": "1450110568185980"
              },
              {
                "name": "verifyToken",
                "text": "Meta webhook verification token",
                "default": ""
              },
              {
                "name": "token",
                "text": "Meta system-user access token",
                "default": "secret://aux4-cloud/whatsapp/token",
                "hide": true,
                "env": "WHATSAPP_TOKEN"
              },
              {
                "name": "appSecret",
                "text": "Meta app secret",
                "default": "secret://aux4-cloud/whatsapp/appSecret",
                "hide": true,
                "env": "WHATSAPP_APP_SECRET"
              },
              {
                "name": "apiUrl",
                "text": "Meta Graph API base URL (override for tests)",
                "default": "https://graph.facebook.com"
              },
              {
                "name": "db",
                "text": "Bot state database",
                "default": "cloud"
              },
              {
                "name": "tmpDir",
                "text": "Temporary attachment directory",
                "default": "/tmp/aux4-bot"
              },
              {
                "name": "dedupeTtl",
                "text": "Webhook dedupe lifetime in seconds",
                "default": "129600"
              },
              {
                "name": "queue",
                "text": "Repository-backed queue configuration",
                "default": "{\"name\":\"whatsapp_bot_inbox\",\"provider\":\"repository\",\"db\":\"cloud\",\"visibility\":\"30\",\"maxAttempts\":\"5\"}"
              },
              {
                "name": "agentMachine",
                "text": "Generic agent VM (uses authenticated completion callbacks)",
                "env": "CLOUD_BOT_AGENT_MACHINE",
                "default": ""
              },
              {
                "name": "brainCommand",
                "text": "Synchronous command that prints a reply (alternative to agentMachine)",
                "env": "CLOUD_BOT_COMMAND",
                "default": ""
              },
              {
                "name": "retryAttempts",
                "text": "Maximum consecutive failed or unexpectedly empty worker attempts",
                "default": "6"
              },
              {
                "name": "retryDelay",
                "text": "Initial retry delay in milliseconds",
                "default": "1000"
              },
              {
                "name": "retryMaxDelay",
                "text": "Maximum retry delay in milliseconds",
                "default": "15000"
              },
              {
                "name": "retryBudget",
                "text": "Milliseconds before stopping new worker attempts",
                "default": "240000"
              },
              {
                "name": "retryMaxMessages",
                "text": "Maximum messages to acknowledge per invocation",
                "default": "100"
              },
              {
                "name": "expected",
                "text": "Internal count of newly enqueued events",
                "private": true,
                "default": "0"
              }
            ]
          },
          "noHooks": true
        },
        {
          "name": "cloud-bot",
          "execute": [
            "profile:cloud-bot"
          ],
          "help": {
            "text": "Inspect the hosted WhatsApp bot"
          }
        }
      ]
    },
    {
      "name": "cloud-bot",
      "commands": [
        {
          "name": "status",
          "execute": [
            "node ${packageDir}/lib/status-info.mjs"
          ],
          "help": {
            "text": "Show capability and database readiness without credentials"
          }
        },
        {
          "name": "work",
          "noHooks": true,
          "execute": [
            "set:botConfig=!node ${packageDir}/lib/config.mjs values(botId, phoneNumberId, verifyToken, token, appSecret, apiUrl, agentMachine, brainCommand)",
            "set:botConfig=json:${botConfig}",
            "set:channels=${botConfig.channels}",
            "set:bots=${botConfig.bots}",
            "set:defaults=${botConfig.defaults}",
            "aux4 bot retry-work --expected value(expected) --attempts value(retryAttempts) --delay value(retryDelay) --maxDelay value(retryMaxDelay) --budget value(retryBudget) --maxMessages value(retryMaxMessages) params(channels, bots, defaults, db, tmpDir, queue)"
          ],
          "help": {
            "text": "Drain queued messages with bounded retries using this bot VM configuration",
            "variables": [
              {
                "name": "botId",
                "text": "Configured bot identifier",
                "default": "whatsapp-bot"
              },
              {
                "name": "phoneNumberId",
                "text": "Meta WhatsApp phone number ID",
                "default": "1450110568185980"
              },
              {
                "name": "verifyToken",
                "text": "Meta webhook verification token",
                "default": ""
              },
              {
                "name": "token",
                "text": "Meta system-user access token",
                "default": "secret://aux4-cloud/whatsapp/token",
                "hide": true,
                "env": "WHATSAPP_TOKEN"
              },
              {
                "name": "appSecret",
                "text": "Meta app secret",
                "default": "secret://aux4-cloud/whatsapp/appSecret",
                "hide": true,
                "env": "WHATSAPP_APP_SECRET"
              },
              {
                "name": "apiUrl",
                "text": "Meta Graph API base URL (override for tests)",
                "default": "https://graph.facebook.com"
              },
              {
                "name": "db",
                "text": "Bot state database",
                "default": "cloud"
              },
              {
                "name": "tmpDir",
                "text": "Temporary attachment directory",
                "default": "/tmp/aux4-bot"
              },
              {
                "name": "dedupeTtl",
                "text": "Webhook dedupe lifetime in seconds",
                "default": "129600"
              },
              {
                "name": "queue",
                "text": "Repository-backed queue configuration",
                "default": "{\"name\":\"whatsapp_bot_inbox\",\"provider\":\"repository\",\"db\":\"cloud\",\"visibility\":\"30\",\"maxAttempts\":\"5\"}"
              },
              {
                "name": "agentMachine",
                "text": "Generic agent VM (uses authenticated completion callbacks)",
                "env": "CLOUD_BOT_AGENT_MACHINE",
                "default": ""
              },
              {
                "name": "brainCommand",
                "text": "Synchronous command that prints a reply (alternative to agentMachine)",
                "env": "CLOUD_BOT_COMMAND",
                "default": ""
              },
              {
                "name": "retryAttempts",
                "text": "Maximum consecutive failed or unexpectedly empty worker attempts",
                "default": "6"
              },
              {
                "name": "retryDelay",
                "text": "Initial retry delay in milliseconds",
                "default": "1000"
              },
              {
                "name": "retryMaxDelay",
                "text": "Maximum retry delay in milliseconds",
                "default": "15000"
              },
              {
                "name": "retryBudget",
                "text": "Milliseconds before stopping new worker attempts",
                "default": "240000"
              },
              {
                "name": "retryMaxMessages",
                "text": "Maximum messages to acknowledge per invocation",
                "default": "100"
              },
              {
                "name": "expected",
                "text": "Newly enqueued messages expected before treating an empty lease as complete",
                "default": "0"
              }
            ]
          }
        },
        {
          "name": "conversations",
          "execute": [
            "aux4 bot conversations --botId whatsapp-bot --db cloud param(limit)"
          ],
          "help": {
            "text": "List logged WhatsApp chats",
            "variables": [
              {
                "name": "limit",
                "text": "Maximum chats",
                "default": "20"
              }
            ]
          }
        },
        {
          "name": "messages",
          "execute": [
            "aux4 bot messages --botId whatsapp-bot --db cloud params(chat, limit)"
          ],
          "help": {
            "text": "Read inbound and outbound messages",
            "variables": [
              {
                "name": "chat",
                "text": "WhatsApp chat identifier",
                "arg": true
              },
              {
                "name": "limit",
                "text": "Maximum messages",
                "default": "50"
              }
            ]
          }
        },
        {
          "name": "invoke",
          "execute": [
            "set:commandPath=!node ${packageDir}/lib/validate-command.mjs value(command*)",
            "aux4 cloud value(target) ${commandPath}"
          ],
          "help": {
            "text": "Invoke an explicitly permitted command as this machine",
            "variables": [
              {
                "name": "target",
                "text": "Target machine name"
              },
              {
                "name": "command",
                "text": "Command path tokens",
                "multiple": true
              }
            ]
          }
        },
        {
          "name": "complete",
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/complete.mjs"
          ],
          "help": {
            "text": "Deliver a correlated agent completion using stored bot routing",
            "variables": []
          }
        },
        {
          "name": "chat",
          "noHooks": true,
          "execute": [
            "stdin:node ${packageDir}/lib/chat-ingest.mjs"
          ],
          "help": {
            "text": "Process signed Cloud Chat deliveries using the machine-owned bot configuration"
          }
        }
      ]
    }
  ]
}
